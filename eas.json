{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://quick-tiger-684.convex.cloud"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://quick-tiger-684.convex.cloud"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://quick-tiger-684.convex.cloud"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
